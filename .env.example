# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on (Railway sets this automatically)
PORT=3000

# Session cookie signing secret — set to a long random string
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login
ADMIN_USER=admin
# Generate with: node hash-password.js "yourPasswordHere"
ADMIN_PASS_HASH=

NODE_ENV=production
